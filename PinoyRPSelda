    Name = "Rejoin",
    Callback = function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end,
})

local DoubleEscEnabled = true
local LastPress = 0
local DoublePressTime = 0.5

MiscTab:CreateToggle({
    Name = "Rejoin (Double ESC)",
    CurrentValue = true,
    Callback = function(Value)
        DoubleEscEnabled = Value
    end,
})

UIS.InputBegan:Connect(function(input, gameProcessed)
    if not DoubleEscEnabled then return end

    if input.KeyCode == Enum.KeyCode.Escape then
        local now = tick()
        if now - LastPress <= DoublePressTime then
            -- Stash items first, wait for the stashing routine to finish, then rejoin
            task.spawn(function()
                stashItems()
                task.wait(1.5) -- Adjust delay if needed to ensure all items send before teleporting
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end)
        end
        LastPress = now
    end
end)
