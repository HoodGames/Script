local LockTab = Window:CreateTab("Lock", 4483362458)
local LockSection = LockTab:CreateSection("Lock Scripts")
LockSection:Set("Lock Scripts")
LockTab:CreateDivider()

local mouse = LocalPlayer:GetMouse()
local targetLock = false
local lockedPlayer = nil
local toggleEnabled = false
local currentKeybind = Enum.KeyCode.T

local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local head = character and character:FindFirstChild("Head")
            local humanoid = character and character:FindFirstChild("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)

                if onScreen then
                    local mousePos = Vector2.new(mouse.X, mouse.Y)
                    local distance = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude

                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end

    return closestPlayer
end

local function lockOntoPlayer()
    local closestPlayer = getClosestPlayer()
    if closestPlayer then
        lockedPlayer = closestPlayer
        targetLock = true
    end
end

local function updateLock()
    if not lockedPlayer or not lockedPlayer.Character then return end

    local character = lockedPlayer.Character
    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")

    if head and root then
        local targetPos = head.Position
        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        if myRoot then
            local distance = (myRoot.Position - root.Position).Magnitude
            local verticalOffset = 0.2 + (distance * 0.03) 
            targetPos = targetPos + Vector3.new(0, verticalOffset, 0)
        end

        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
    else
        lockedPlayer = nil
        targetLock = false
    end
end

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == currentKeybind then
        if not toggleEnabled then return end

        if targetLock then
            targetLock = false
            lockedPlayer = nil
        else
            lockOntoPlayer()
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if toggleEnabled and targetLock then
        updateLock()
    end
end)

LockTab:CreateToggle({
    Name = "AimLock Head (T)",
    CurrentValue = false,
    Flag = "TargetLockToggle",
    Callback = function(Value)
        toggleEnabled = Value
        if not Value then
            targetLock = false
            lockedPlayer = nil
        end
    end,
})


