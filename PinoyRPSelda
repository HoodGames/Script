-- --- HITBOX EXPANDER ---
local HITBOX_ENABLED = false
local HITBOX_PART = "Head"
local HITBOX_SIZE = 10
local ORIGINAL_HITBOX = {}

local function getTargetPart(char)
    if HITBOX_PART == "Head" then
        return char:FindFirstChild("Head")
    else
        return char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("LowerTorso")
    end
end

local function applyHitbox(player, char)
    if player == LocalPlayer then return end
    if not char then return end

    local part = getTargetPart(char)
    if not part then return end

    ORIGINAL_HITBOX[player] = ORIGINAL_HITBOX[player] or {}

    if not ORIGINAL_HITBOX[player][part] then
        ORIGINAL_HITBOX[player][part] = {
            Size = part.Size,
            Transparency = part.Transparency,
            Material = part.Material,
            Color = part.Color
        }
    end

    local originalSize = ORIGINAL_HITBOX[player][part].Size
    part.Size = originalSize * HITBOX_SIZE
    part.Transparency = 0.7
    part.Material = ORIGINAL_HITBOX[player][part].Material
    part.Color = ORIGINAL_HITBOX[player][part].Color
    part.CanCollide = false
    part.Massless = true
end

local function restoreHitbox(player, char)
    if player == LocalPlayer then return end
    if not char then return end
    if not ORIGINAL_HITBOX[player] then return end

    for part, data in pairs(ORIGINAL_HITBOX[player]) do
        if part and part.Parent then
            pcall(function()
                part.Size = data.Size
                part.Transparency = data.Transparency
                part.Material = data.Material
                part.Color = data.Color
                part.CanCollide = true
            end)
        end
    end

    ORIGINAL_HITBOX[player] = nil
end

function enableHitbox()
    HITBOX_ENABLED = true
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            applyHitbox(p, p.Character)
        end
    end
end

function disableHitbox()
    HITBOX_ENABLED = false
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            restoreHitbox(p, p.Character)
        end
    end
end

