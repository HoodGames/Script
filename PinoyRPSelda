-- INVENTORY ESP (UNLIMITED DISTANCE & FIXED SCALING)
-- =====================================================================
local BILLBOARDS = {}
local SHOWING_INVENTORY = false

local BLACKLIST = {
    ["apple"]=true,["water"]=true,["banana"]=true,["donut"]=true,["coffee"]=true,["fist"]=true,
    ["gun stock"]=true,["gun action"]=true,["gun barrel"]=true,["tape"]=true,["blueprint"]=true,
    ["fabric"]=true,["steel"]=true,["steel plate"]=true,["refined powder"]=true,["gunpowder"]=true,
    ["rolling paper"]=true,["med powder"]=true,["empty capsule"]=true,["shell casing"]=true,["medicine powder"]=true,
}

local function isBlacklisted(name)
    return BLACKLIST[string.lower(name)] == true
end

local function getInventory(player)
    if player == LocalPlayer then return "None" end
    local items = {}

    if player:FindFirstChild("Backpack") then
        for _, tool in ipairs(player.Backpack:GetChildren()) do
            if tool:IsA("Tool") and not isBlacklisted(tool.Name) then
                table.insert(items, tool.Name)
            end
        end
    end

    if player.Character then
        for _, tool in ipairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") and not isBlacklisted(tool.Name) then
                table.insert(items, tool.Name)
            end
        end
    end

    return (#items == 0) and "None" or table.concat(items, ", ")
end

local function updateBillboard(player)
    local billboard = BILLBOARDS[player]
    if billboard and billboard.Parent then
        local textLabel = billboard:FindFirstChildOfClass("TextLabel")
        if textLabel then
            local display = player.DisplayName or player.Name
            local username = "@" .. player.Name
            textLabel.Text =
                "<font size='8'>" .. display .. "</font>\n" ..
                "<font size='7'>" .. username .. "</font>\n" ..
                "<font size='10'>" .. getInventory(player) .. "</font>"
        end
    end
end

local function removeBillboard(player)
    if BILLBOARDS[player] then
        if BILLBOARDS[player].Parent then
            BILLBOARDS[player]:Destroy()
        end
        BILLBOARDS[player] = nil
    end
end

local function createBillboard(player)
    if player == LocalPlayer then return end
    removeBillboard(player)

    local char = player.Character
    if not char then return end
    
    local head = char:WaitForChild("Head", 3)
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "InventoryESP_Gui"
    billboard.AlwaysOnTop = true
    -- Using a smaller studs size so it scales cleanly across distances without overlapping massively
    billboard.Size = UDim2.new(0, 140, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2.2, 0)
    -- Removed MaxDistance so it renders globally across the map
    billboard.Parent = head

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextStrokeTransparency = 0.2
    text.Font = Enum.Font.SourceSansBold
    text.TextScaled = true
    text.TextWrapped = true
    text.RichText = true
    text.Parent = billboard

    BILLBOARDS[player] = billboard
    updateBillboard(player)
end

local function hookInventory(player)
    if player == LocalPlayer then return end

    local function monitorContainer(container)
        if not container then return end
        container.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then task.wait(0.1) updateBillboard(player) end
        end)
        container.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then task.wait(0.1) updateBillboard(player) end
        end)
    end

    if player:FindFirstChild("Backpack") then
        monitorContainer(player.Backpack)
    end

    player.CharacterAdded:Connect(function(char)
        task.wait(0.8)
        monitorContainer(char)
        if SHOWING_INVENTORY then
            createBillboard(player)
        end
    end)

    if player.Character then
        monitorContainer(player.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    hookInventory(p)
end

Players.PlayerAdded:Connect(hookInventory)

Players.PlayerRemoving:Connect(function(player)
    removeBillboard(player)
end)

function enableInventoryESP()
    SHOWING_INVENTORY = true
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            createBillboard(p)
        end
    end
end

function disableInventoryESP()
    SHOWING_INVENTORY = false
    for _, p in ipairs(Players:GetPlayers()) do
        removeBillboard(p)
    end
end

MainTab:CreateKeybind({
    Name = "Inventory ESP",
    CurrentKeybind = "G",
    Callback = function()
        if SHOWING_INVENTORY then disableInventoryESP() else enableInventoryESP() end
    end,
})

