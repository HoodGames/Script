        if foundItem then
            local clickDetector = foundItem:FindFirstChild("ClickDetector", true)
            local handle = foundItem:FindFirstChild("Handle") or foundItem:FindFirstChildWhichIsA("BasePart", true)

            if clickDetector then
                pcall(function() fireclickdetector(clickDetector) end)
            elseif handle then
                local character = LocalPlayer.Character
