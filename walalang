local function removeESP(player)
    if ESP_HIGHLIGHTS[player] then
        pcall(function() ESP_HIGHLIGHTS[player]:Destroy() end)
        ESP_HIGHLIGHTS[player] = nil
    end
end

local function applyESP(player, char)
    if player == LocalPlayer or not char then return end
    removeESP(player)

    local h = Instance.new("Highlight")
    h.Name = "ESP_Highlight"
    h.FillTransparency = 1
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = char

    ESP_HIGHLIGHTS[player] = h
