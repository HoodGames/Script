    ["pipe"]=true, ["rake"]=true, ["sledgehammer"]=true, ["butcher knife"]=true, ["wrench"]=true, ["frying pan"]=true
}

local BLACK_ITEMS = {
    ["koth box 1"]=true, ["koth box 2"]=true, ["koth box 3"]=true
}

local function isBlacklisted(name)
    return BLACKLIST[string.lower(name)] == true
end

local function getFormattedInventory(player)
    if player == LocalPlayer then return "None" end
    local items = {}

    local function collectTools(container)
        if not container then return end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and not isBlacklisted(tool.Name) then
                local lowerName = string.lower(tool.Name)
                local displayName = tool.Name
                
                if RED_ITEMS[lowerName] then
                    table.insert(items, '<font color="rgb(255, 50, 50)">' .. displayName .. '</font>')
                elseif BLUE_ITEMS[lowerName] then
                    table.insert(items, '<font color="rgb(50, 150, 255)">' .. displayName .. '</font>')
                elseif GREEN_ITEMS[lowerName] then
                    table.insert(items, '<font color="rgb(50, 255, 50)">' .. displayName .. '</font>')
                elseif BLACK_ITEMS[lowerName] then
                    table.insert(items, '<font color="rgb(35, 35, 35)">' .. displayName .. '</font>')
                else
                    table.insert(items, '<font color="rgb(255, 255, 255)">' .. displayName .. '</font>')
                end
            end
        end
    end

    if player:FindFirstChild("Backpack") then
        collectTools(player.Backpack)
    end

    if player.Character then
        collectTools(player.Character)
    end

    return (#items == 0) and "None" or table.concat(items, ", ")
end

local function getFormattedLeaderstats(player)
    if player == LocalPlayer then return "" end
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return "Bank: ₱0 | DWallet: ₱0 | Wallet: ₱0" end

    local bank = leaderstats:FindFirstChild("BankData") and leaderstats.BankData.Value or 0
    local dwallet = leaderstats:FindFirstChild("DirtyWallet") and leaderstats.DirtyWallet.Value or 0
    local wallet = leaderstats:FindFirstChild("WalletData") and leaderstats.WalletData.Value or 0

    return string.format("Bank: ₱%s | DWallet: ₱%s | Wallet: ₱%s", tostring(bank), tostring(dwallet), tostring(wallet))
end

