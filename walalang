            task.wait(0.2)
            if ESP_ENABLED then
                applyESP(player, char)
            end
        end
    end)
    table.insert(PlayerConnections[player], charConn)

    if player.Character and ESP_ENABLED then
        applyESP(player, player.Character)
    end
end

