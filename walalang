                if hrp then
                    pcall(function()
                        firetouchinterest(hrp, handle, 0)
                        task.wait(0.05)
                        firetouchinterest(hrp, handle, 1)
                    end)
                end
            else
                warn("ClickDetector or Handle not found for: " .. itemName)
            end
        else
            warn("Item not found on map: " .. itemName)
        end
    end)
end

