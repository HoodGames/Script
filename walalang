local backpackDropdown = nil
local currentBackpackItems = {}

local function stashBackpackItem(toolName)
    if not checkCooldown() then return end

    if isBlacklistedStash(toolName) then
        return
    end

    task.spawn(function()
        local safeboxFolder = workspace:FindFirstChild("SafesOnMap")
        if not safeboxFolder then return end

        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local closestSafeBox = nil
        local shortestDist = math.huge

        for _, safeBox in ipairs(safeboxFolder:GetChildren()) do
            local mainPart = safeBox:FindFirstChild("MainDoor") or safeBox:FindFirstChild("Part") or safeBox:FindFirstChildWhichIsA("BasePart")
            if mainPart then
                local dist = (hrp.Position - mainPart.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestSafeBox = safeBox
                end
            end
        end

        if not closestSafeBox then return end

        local targetPart = closestSafeBox:FindFirstChild("MainDoor") 
            or closestSafeBox:FindFirstChild("Part") 
            or closestSafeBox:FindFirstChildWhichIsA("BasePart")

        local clickDetector = closestSafeBox:FindFirstChild("ClientClick") or closestSafeBox:FindFirstChild("ClickDetector", true)

        if not targetPart then return end

        if clickDetector then
            pcall(function() fireclickdetector(clickDetector) end)
        else
            pcall(function()
                firetouchinterest(hrp, targetPart, 0)
                task.wait(0.05)
                firetouchinterest(hrp, targetPart, 1)
            end)
        end

        task.wait(0.3)

        local safeBoxRemote = ReplicatedStorage:FindFirstChild("SafeBox") and ReplicatedStorage.SafeBox:FindFirstChild("Inventory")
        if safeBoxRemote then
            pcall(function()
                safeBoxRemote:FireServer("Change", toolName, "Backpack")
            end)
        end
    end)
end

local function getBackpackItemList()
    local options = {}
    currentBackpackItems = {}
    local toolCounts = {}

    local function collectFromContainer(container)
        if not container then return end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and not isBlacklistedStash(tool.Name) then
                toolCounts[tool.Name] = (toolCounts[tool.Name] or 0) + 1
            end
        end
    end

    collectFromContainer(LocalPlayer:FindFirstChild("Backpack"))
    collectFromContainer(LocalPlayer.Character)

    for toolName, count in pairs(toolCounts) do
        local formattedName = toolName .. " (" .. tostring(count) .. "x)"
        table.insert(options, formattedName)
        currentBackpackItems[formattedName] = toolName
    end

    if #options == 0 then
        table.insert(options, "Inventory Empty")
    end

    return options
end

backpackDropdown = StashTab:CreateDropdown({
    Name = "Select Backpack Item to Stash",
    Options = getBackpackItemList(),
    CurrentOption = {"Select Item"},
    MultipleOptions = false,
    Callback = function(option)
        local selectedDisplay = option[1]
        local actualToolName = currentBackpackItems[selectedDisplay]
        if actualToolName then
            stashBackpackItem(actualToolName)
        end
    end,
})

local isRefreshing = false
local function refreshBackpackDropdown()
    if backpackDropdown and not isRefreshing then
        isRefreshing = true
        pcall(function()
            backpackDropdown:Refresh(getBackpackItemList(), true)
        end)
        task.wait(0.3)
        isRefreshing = false
    end
end

