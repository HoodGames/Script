}

local function shouldExclude(prompt)
    if EXCLUDED_PROMPTS[prompt.Name] then return true end
    local parent = prompt.Parent
    while parent and parent ~= workspace do
        if parent.Name == "NPCs" or parent.Name == "Blackmarket" or parent.Name == "GunD" or parent.Name == "Shop1" or parent.Name == "Shop2" then
            return true
        end
        parent = parent.Parent
    end
    return false
end

