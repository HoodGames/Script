local autoMopEnabled = false
local autoMopToggleObj

autoMopToggleObj = AutoTab:CreateToggle({
    Name = "Auto Mop",
    CurrentValue = false,
    Flag = "AutoMopToggle",
    Callback = function(Value)
        autoMopEnabled = Value

        local function getCharacterParts()
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            return char, humanoid, rootPart
        end

        local function checkAndEquipMop()
            local char, humanoid = getCharacterParts()
            if not char or not humanoid then return false end
            
            if char:FindFirstChild("Mop") then return true end
            
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack then
                local mopTool = backpack:FindFirstChild("Mop")
                if mopTool then
                    pcall(function() humanoid:EquipTool(mopTool) end)
                    task.wait(0.2)
                    return true
                end
            end
            
            return false
        end

        local function getNearestDirt()
            local _, _, rootPart = getCharacterParts()
            if not rootPart then return nil end

            local linisMoney = workspace:FindFirstChild("LinisMoney")
            local activeDirts = linisMoney and linisMoney:FindFirstChild("ActiveDirts")
            
            if not activeDirts then return nil end

            local nearestDirt = nil
            local shortestDistance = math.huge

            for _, dirt in ipairs(activeDirts:GetChildren()) do
                local targetPart = dirt:IsA("BasePart") and dirt or dirt:FindFirstChildWhichIsA("BasePart", true)
                local prompt = dirt:FindFirstChildWhichIsA("ProximityPrompt", true)

                if targetPart and prompt then
                    local distance = (targetPart.Position - rootPart.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        nearestDirt = dirt
                    end
                end
            end

            return nearestDirt
        end

        if autoMopEnabled then
            if not checkAndEquipMop() then
                autoMopEnabled = false
                if autoMopToggleObj and autoMopToggleObj.Set then
                    autoMopToggleObj:Set(false)
                end
                warn("Get a MOP!")
                pcall(function()
                    Rayfield:Notify({Title = "Auto Mop", Content = "Get a MOP!", Duration = 3})
                end)
                return
            end

            task.spawn(function()
                while autoMopEnabled do
                    local nearestDirt = getNearestDirt()
                    
                    if nearestDirt then
                        local prompt = nearestDirt:FindFirstChildWhichIsA("ProximityPrompt", true)
                        local targetPart = nearestDirt:IsA("BasePart") and nearestDirt or nearestDirt:FindFirstChildWhichIsA("BasePart", true)
                        
                        if prompt and targetPart then
                            local char, humanoid, rootPart = getCharacterParts()
                            if humanoid and rootPart then
                                pcall(function()
                                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
                                end)
                                
                                humanoid:MoveTo(targetPart.Position)
                                
                                local startTime = tick()
                                repeat 
                                    task.wait(0.1)
                                    if (targetPart.Position - rootPart.Position).Magnitude > 4 then
                                        humanoid:MoveTo(targetPart.Position)
                                    end
                                until (targetPart.Position - rootPart.Position).Magnitude <= 4 or (tick() - startTime > 8) or not autoMopEnabled

                                humanoid:MoveTo(rootPart.Position)
                                pcall(function()
                                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
                                end)
                            end

                            if not autoMopEnabled then break end
                            task.wait(0.1)

                            if fireproximityprompt then
                                pcall(function() fireproximityprompt(prompt, 0, true) end)
                            else
                                pcall(function()
                                    prompt:InputHoldBegin()
                                    task.wait(0.1)
                                    prompt:InputHoldEnd()
                                end)
                            end

                            task.wait(0.2)
                            if autoMopEnabled then
                                local nextDirt = getNearestDirt()
                                if nextDirt and nextDirt ~= nearestDirt then
                                    local nextTarget = nextDirt:IsA("BasePart") and nextDirt or nextDirt:FindFirstChildWhichIsA("BasePart", true)
                                    local _, nextHum, _ = getCharacterParts()
                                    if nextTarget and nextHum then
                                        pcall(function()
                                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
                                            nextHum:MoveTo(nextTarget.Position)
                                        end)
                                    end
                                end
                            end

                            task.wait(1.0)
                        end
                    else
                        task.wait(0.5)
                    end
                end
                
                pcall(function()
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
                end)
            end)
        else
            pcall(function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
            end)
        end
    end,
})

