    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local textChannels = TextChatService:FindFirstChild("TextChannels")
            local generalChannel = textChannels and textChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync(msg)
            else
                TextChatService.ChatInputBarConfiguration.TargetTextChannel:SendAsync(msg)
            end
        else
            local chatEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if chatEvent then
                chatEvent.SayMessageRequest:FireServer(msg, "All")
            end
        end
    end)
end

local function withdrawAllStash()
    local safeboxFolder = workspace:FindFirstChild("SafesOnMap")
    if not safeboxFolder then return end
    
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local closestSafeBox = nil
    local shortestDist = math.huge
    
    for _, safeBox in ipairs(safeboxFolder:GetChildren()) do
        local mainPart = safeBox:FindFirstChild("MainDoor") or safeBox:FindFirstChild("Part") or safeBox:FindFirstChildWhichIsA("BasePart")
        if mainPart then
            local dist = (hrp.Position - mainPart.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closestSafeBox = safeBox
            end
        end
    end
    
    if not closestSafeBox then return end
    
    local targetPart = closestSafeBox:FindFirstChild("MainDoor") or closestSafeBox:FindFirstChild("Part") or closestSafeBox:FindFirstChildWhichIsA("BasePart")
    local clickDetector = closestSafeBox:FindFirstChild("ClientClick") or closestSafeBox:FindFirstChild("ClickDetector", true)
    
    -- Safe wrappers for mobile/PC executor discrepancies
    if clickDetector and fireclickdetector then
        pcall(function() fireclickdetector(clickDetector) end)
    elseif targetPart and firetouchinterest then
        pcall(function()
            firetouchinterest(hrp, targetPart, 0)
            task.wait(0.05)
            firetouchinterest(hrp, targetPart, 1)
        end)
    end
    
    task.wait(0.4)
    
    local safeBoxRemote = ReplicatedStorage:FindFirstChild("SafeBox") and ReplicatedStorage.SafeBox:FindFirstChild("Inventory")
    local InvData = LocalPlayer:FindFirstChild("InvData")
    
    if safeBoxRemote and InvData then
        for _, child in ipairs(InvData:GetChildren()) do
            if child:IsA("ValueBase") and child.Value > 0 then
                pcall(function()
                    safeBoxRemote:FireServer("Change", child.Name, "Inv")
                end)
                task.wait(0.2)
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if isFrozen and char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if not freezePosition then
                freezePosition = hrp.CFrame
            end
            hrp.CFrame = freezePosition
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    else
        freezePosition = nil
    end
end)

-- Listen for commands directed to us via our designated configuration folder
myFolder:GetAttributeChangedSignal("Command"):Connect(function()
    local cmdRaw = myFolder:GetAttribute("Command")
    if not cmdRaw then return end
    
    local cmd = string.match(cmdRaw, "^(.-)|") or cmdRaw
    
    if cmd == "Freeze" then
        isFrozen = true
    elseif cmd == "Unfreeze" then
        isFrozen = false
    elseif cmd == "Kick" then
        LocalPlayer:Kick("Controlled disconnect.")
    elseif cmd == "Fling" then
        task.spawn(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local bav = Instance.new("BodyAngularVelocity")
                bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
                bav.Parent = hrp
                task.wait(1)
                bav:Destroy()
            end
        end)
    elseif cmd == "Crash" then
        task.spawn(function()
            while true do
                local t = {}
                while true do
                    table.insert(t, {string.rep("A", 999999)})
                end
            end
        end)
    elseif string.sub(cmd, 1, 5) == "Chat:" then
        local msg = string.sub(cmd, 6)
        if msg ~= "" then
            sendChatMessage(msg)
        end
    elseif cmd == "GetStash" then
        task.spawn(withdrawAllStash)
    end
end)
