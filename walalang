local function hookInventory(player)
    if player == LocalPlayer then return end

    local function monitorContainer(container)
        if not container then return end
        local c1 = container.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                task.wait(0.05)
                updateBillboard(player)
            end
        end)
        local c2 = container.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then
                task.wait(0.05)
                updateBillboard(player)
            end
        end)
        
        InvConnections[player] = InvConnections[player] or {}
        table.insert(InvConnections[player], c1)
        table.insert(InvConnections[player], c2)
    end

    local function monitorLeaderstats(ls)
        if not ls then return end
        for _, stat in ipairs(ls:GetChildren()) do
            if stat:IsA("ValueBase") then
                local conn = stat.Changed:Connect(function()
                    updateBillboard(player)
                end)
                table.insert(InvConnections[player], conn)
            end
        end
        local addedConn = ls.ChildAdded:Connect(function(stat)
            if stat:IsA("ValueBase") then
                local conn = stat.Changed:Connect(function()
                    updateBillboard(player)
                end)
                table.insert(InvConnections[player], conn)
                updateBillboard(player)
            end
        end)
        table.insert(InvConnections[player], addedConn)
    end

    InvConnections[player] = InvConnections[player] or {}

    if player:FindFirstChild("Backpack") then
        monitorContainer(player.Backpack)
    end

    local ls = player:FindFirstChild("leaderstats")
    if ls then
        monitorLeaderstats(ls)
    else
        local lsConn
        lsConn = player.ChildAdded:Connect(function(child)
            if child.Name == "leaderstats" then
                monitorLeaderstats(child)
                lsConn:Disconnect()
            end
        end)
        table.insert(InvConnections[player], lsConn)
    end

    local charConn = player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        monitorContainer(char)
        if player:FindFirstChild("Backpack") then
            monitorContainer(player.Backpack)
        end
        if SHOWING_INVENTORY then
            createBillboard(player)
        end
    end)

    table.insert(InvConnections[player], charConn)

    if player.Character then
        monitorContainer(player.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
