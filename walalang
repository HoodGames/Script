local function isBlacklistedStash(name)
    return BLACKLISTED_STASH_ITEMS[string.lower(name)] == true
end

local function stashItems()
    if not MASTER_STASH_ENABLED then return end
    if not checkCooldown() then return end

    task.spawn(function()
        local safeboxFolder = workspace:FindFirstChild("SafesOnMap")
        if not safeboxFolder then
            warn("SafesOnMap folder not found in workspace!")
            return
        end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if humanoid then
            pcall(function()
                humanoid:UnequipTools()
            end)
            task.wait(0.05)
        end

        local closestSafeBox = nil
        local shortestDist = math.huge

        for _, safeBox in ipairs(safeboxFolder:GetChildren()) do
            local mainPart = safeBox:FindFirstChild("MainDoor") or safeBox:FindFirstChild("Part") or safeBox:FindFirstChildWhichIsA("BasePart")
            if mainPart then
                local dist = (hrp.Position - mainPart.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestSafeBox = safeBox
                end
            end
        end

        if not closestSafeBox then
            warn("No SafeBox found!")
            return
        end

        local targetPart = closestSafeBox:FindFirstChild("MainDoor") 
            or closestSafeBox:FindFirstChild("Part") 
            or closestSafeBox:FindFirstChildWhichIsA("BasePart")

        local clickDetector = closestSafeBox:FindFirstChild("ClientClick") or closestSafeBox:FindFirstChild("ClickDetector", true)

        if not targetPart then
            warn("SafeBox part not found!")
            return
        end

        if clickDetector then
            pcall(function() fireclickdetector(clickDetector) end)
        else
            pcall(function()
                firetouchinterest(hrp, targetPart, 0)
                task.wait(0.05)
                firetouchinterest(hrp, targetPart, 1)
            end)
        end

        task.wait(0.3)

        local safeBoxRemote = ReplicatedStorage:FindFirstChild("SafeBox") and ReplicatedStorage.SafeBox:FindFirstChild("Inventory")
        local backpack = LocalPlayer:FindFirstChild("Backpack")

        if safeBoxRemote and backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if not MASTER_STASH_ENABLED then break end
                if tool:IsA("Tool") and not isBlacklistedStash(tool.Name) then
                    pcall(function()
                        safeBoxRemote:FireServer("Change", tool.Name, "Backpack", "SafeBox")
                    end)
                    pcall(function()
                        safeBoxRemote:FireServer("Deposit", tool)
                    end)
                    task.wait(0.12)
                end
            end
        else
            warn("SafeBox RemoteEvent or Backpack not found!")
        end
    end)
end

