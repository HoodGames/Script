local function getPlayersFromString(inputStr)
    local matchedPlayers = {}
    if not inputStr or inputStr == "" then return matchedPlayers end
    
    for query in string.gmatch(inputStr, "([^,]+)") do
        query = query:match("^%s*(.-)%s*$")
        query = string.lower(query)
        
        if query ~= "" then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local nameLower = string.lower(player.Name)
                    local displayNameLower = string.lower(player.DisplayName or "")
                    
                    if string.sub(nameLower, 1, #query) == query or string.sub(displayNameLower, 1, #query) == query or string.find(nameLower, query) or string.find(displayNameLower, query) then
                        if not table.find(matchedPlayers, player) then
                            table.insert(matchedPlayers, player)
                        end
                    end
                end
            end
        end
    end
    
    return matchedPlayers
end

